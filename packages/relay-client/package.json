{
  "name": "@pleaseai/relay-client",
  "type": "module",
  "version": "0.1.1",
  "description": "WebSocket relay client for webhook events",
  "license": "FSL-1.1-MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pleaseai/relay.git",
    "directory": "packages/relay-client"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "LICENSE",
    "README.md",
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsdown",
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "bun test"
  },
  "dependencies": {
    "consola": "^3.4.2",
    "partysocket": "^1.1.16"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.1",
    "bun-types": "^1.3.10",
    "publint": "^0.3.12",
    "tsdown": "^0.21.7",
    "typescript": "^5.7.0"
  }
}
